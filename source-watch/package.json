{
  "name": "barometre-source-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Source-watching tooling for the Baromètre de la planification écologique (URL audit, SDES value verification against Grist, propositions).",
  "scripts": {
    "audit-source-urls": "node scripts/audit-source-urls.js",
    "build-propositions": "node scripts/build-propositions.js",
    "watch-sources": "node scripts/watch-sources.js",
    "verify-grist-values": "node scripts/verify-grist-values.js",
    "test": "jest --config jest.config.js",
    "lint": "eslint --config .eslintrc.cjs --resolve-plugins-relative-to . scripts tests"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0"
  }
}
